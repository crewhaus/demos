# Copy to .env (Bun auto-loads ./.env from this directory on `bunx crewhaus run`
# and for the spawned thredz-mcp server). Fill in what you need.

# ── Model (required to RUN the agent) ─────────────────────────────────────
# Either works; ANTHROPIC_AUTH_TOKEN takes precedence if both are set.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...

# ── Thredz wiki = the expert's long-term memory (required) ────────────────
# A Thredz API key WITH A WIKI GRANT (read-write or admin). See the Thredz
# API docs: create a key, then grant wiki access via /api/wiki/access.
THREDZ_API_KEY=
# Hosted Thredz. Default if unset. Point at http://localhost:3000/api for a
# local Thredz dev server, or http://127.0.0.1:3210/api for the desktop app.
THREDZ_API_BASE=https://thredz.crewhaus.ai/api

# ── Web research (required for /study and heartbeat STUDY to hit the web) ──
# The `researcher` sub-agent uses WebSearch/WebFetch. Provide a search
# provider + key (e.g. brave, tavily) per your CrewHaus setup.
CREWHAUS_SEARCH_PROVIDER=
CREWHAUS_SEARCH_API_KEY=

# ── Slack (only for the daemon.yaml channel daemon) ───────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
