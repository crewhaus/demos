# Copy to .env (Bun auto-loads ./.env from this directory on
# `bunx crewhaus run`). Fill in what you need.

# ── Model (required to RUN the agent) ─────────────────────────────────────
# Either works; ANTHROPIC_AUTH_TOKEN takes precedence if both are set.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...

# ── Thredz wiki = the expert's long-term memory (crewhaus.yaml) ───────────
# `thredz: true` in the spec resolves this at boot (fail-fast, exit 21 when
# unset) and delivers it to the synthesized `npx thredz-mcp` server. Needs a
# WIKI GRANT (read-write or admin): create a key, then grant wiki access via
# /api/wiki/access.
THREDZ_API_KEY=
# Self-hosted / local Thredz? Use the object form in crewhaus.yaml instead:
#   thredz: { api_key: $THREDZ_API_KEY, base_url: http://localhost:3000/api }

# ── Web research (required for /study and heartbeat STUDY to hit the web) ──
# The `researcher` sub-agent uses WebSearch/WebFetch. Provide a search
# provider + key (e.g. brave, tavily) per your CrewHaus setup.
CREWHAUS_SEARCH_PROVIDER=
CREWHAUS_SEARCH_API_KEY=

# ── Slack (only for the daemon.yaml channel daemon) ───────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
