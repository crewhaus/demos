# Either of these works. Token (Claude Pro/Max OAuth) is preferred.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# The designer reads TWO checkouts at startup: the demos repo (the recipe
# catalog it picks a target shape from) and the crewhaus-factory repo (the
# Zod spec schema it validates generated YAML against). Point these at
# local clones and it reads them directly — no network, no cache.
#
# Leave either EMPTY and it is ignored: the designer probes its own parent
# directories, then falls back to ~/.crewhaus/demos-cache and
# ~/.crewhaus/factory-cache, cloning only if that cache is absent.
#
# From an uncopied starters/harness-designer, the parents are:
#   CREWHAUS_DEMOS_PATH=../..
#   CREWHAUS_FACTORY_PATH=../../../factory
CREWHAUS_DEMOS_PATH=
CREWHAUS_FACTORY_PATH=
