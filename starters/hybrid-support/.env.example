# Copy to .env (Bun auto-loads ./.env from this directory on
# `bunx crewhaus run`).

# ── Model (required) ──────────────────────────────────────────────────────
# Either works; ANTHROPIC_AUTH_TOKEN takes precedence if both are set.
# One key covers all three profiles — fast, strong and checker are the same
# provider, so a hybrid setup costs you no extra credential.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...
